{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@whiskmate/recipe/feature-search": [
        "./apps/whiskmate/src/app/recipe/feature-search/index.ts"
      ],
      "@whiskmate/recipe/infra": [
        "./apps/whiskmate/src/app/recipe/infra/index.ts"
      ],
      "@whiskmate/recipe/model": [
        "./apps/whiskmate/src/app/recipe/model/index.ts"
      ],
      "@whiskmate/recipe/ui": ["./apps/whiskmate/src/app/recipe/ui/index.ts"],
      "@whiskmate/recipe/ui-search": [
        "./apps/whiskmate/src/app/recipe/ui-search/index.ts"
      ],
      "@whiskmate/shared-recipe/model": [
        "./apps/whiskmate/src/app/shared-recipe/model/index.ts"
      ],
      "@whiskmate/shared-recipe/testing": [
        "./apps/whiskmate/src/app/shared-recipe/testing/index.ts"
      ],
      "@whiskmate/shared/ui": ["./apps/whiskmate/src/app/shared/ui/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
